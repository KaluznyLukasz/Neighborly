rules_version = '2';

// Reguły bezpieczeństwa Firestore dla Neighborly.
// Odwzorowują TRD §4 + podkolekcję favorites (zapisane oferty).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Czy userId zablokował zalogowanego. Lista blokad jest prywatna, ale reguły mogą ją czytać —
    // zablokowany nie napisze ani nie złoży prośby, choć nie wie, że go zablokowano.
    function isBlockedBy(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/blocked/$(request.auth.uid));
    }

    // Profil czyta każdy zalogowany, więc nie może trzymać e-maila (ten żyje w Firebase Auth).
    // Usunięcie starego pola `email` wolno, dopisanie lub zmiana — nie.
    function keepsEmailOut() {
      return !('email' in request.resource.data)
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']);
    }

    // /users/{userId}
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId
        && !('email' in request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == userId && keepsEmailOut();
      allow delete: if isSignedIn() && request.auth.uid == userId;
      // Inny użytkownik może zaktualizować tylko reviewCount/rating po wystawieniu recenzji
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewCount', 'rating']);

      // /users/{userId}/favorites/{offerId} — zapisane oferty użytkownika
      match /favorites/{offerId} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;
        // Nie można polubić własnej oferty
        allow create, update: if isSignedIn() && request.auth.uid == userId &&
          get(/databases/$(database)/documents/offers/$(offerId)).data.ownerId != request.auth.uid;
      }

      // /users/{userId}/blocked/{blockedUserId} — zablokowani użytkownicy
      match /blocked/{blockedUserId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // /offers/{offerId}
    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // /transactions/{transactionId}
    match /transactions/{transactionId} {
      allow read: if isSignedIn() &&
        (resource.data.requesterId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      // Deterministyczne ID {offerId}_{requesterId} — brak duplikatów aplikacji
      allow create: if isSignedIn() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.ownerId != request.auth.uid &&
        !isBlockedBy(request.resource.data.ownerId) &&
        !exists(/databases/$(database)/documents/transactions/$(transactionId));
      allow update: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid || resource.data.requesterId == request.auth.uid);
      // Usuwanie tylko odrzuconych/anulowanych aplikacji przez właściciela lub wnioskodawcę
      allow delete: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid || resource.data.requesterId == request.auth.uid) &&
        (resource.data.status == 'rejected' || resource.data.status == 'cancelled' || resource.data.status == 'completed');

      // /transactions/{transactionId}/messages/{messageId} — czat powiązany z aplikacją
      match /messages/{messageId} {
        function transactionData() {
          return get(/databases/$(database)/documents/transactions/$(transactionId)).data;
        }

        function isParticipant() {
          return transactionData().ownerId == request.auth.uid || transactionData().requesterId == request.auth.uid;
        }

        function otherParty() {
          return transactionData().ownerId == request.auth.uid ? transactionData().requesterId : transactionData().ownerId;
        }

        allow read: if isSignedIn() && isParticipant();
        allow create: if isSignedIn() && isParticipant() &&
          request.resource.data.senderId == request.auth.uid &&
          !isBlockedBy(otherParty());
        allow update: if false;
        // Tylko przy kasowaniu zakończonej transakcji (usuwanie konta najpierw ją anuluje)
        allow delete: if isSignedIn() && isParticipant() &&
          transactionData().status in ['rejected', 'cancelled', 'completed'];
      }
    }

    // /alerts/{alertId} — krótkotrwałe ogłoszenia dla sąsiadów (wygasają po 48 h)
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80 &&
        request.resource.data.details is string && request.resource.data.details.size() <= 500 &&
        request.resource.data.expiresAt <= request.time + duration.value(49, 'h') &&
        // Zdjęcie jako base64 w dokumencie — limit dokumentu to 1 MiB, zostawiamy zapas
        (!('imageBase64' in request.resource.data) || request.resource.data.imageBase64.size() < 700000);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      // /alerts/{alertId}/threads/{viewerId} — rozmowa sąsiada (viewerId) z autorem ogłoszenia
      match /threads/{viewerId} {
        function alertAuthorId() {
          return get(/databases/$(database)/documents/alerts/$(alertId)).data.authorId;
        }

        function isThreadParticipant() {
          return request.auth.uid == viewerId || alertAuthorId() == request.auth.uid;
        }

        allow read: if isSignedIn() && isThreadParticipant();
        // Wątek zakłada sąsiad; autor może go tylko aktualizować (odpowiedź)
        allow create: if isSignedIn() && request.auth.uid == viewerId &&
          request.auth.uid != alertAuthorId() &&
          !isBlockedBy(alertAuthorId());
        allow update: if isSignedIn() && isThreadParticipant();
        // Usunięcie ogłoszenia albo konta zabiera wątki ze sobą
        allow delete: if isSignedIn() && isThreadParticipant();

        match /messages/{messageId} {
          allow read: if isSignedIn() && isThreadParticipant();
          allow create: if isSignedIn() && isThreadParticipant() &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000 &&
            !isBlockedBy(request.auth.uid == viewerId ? alertAuthorId() : viewerId);
          allow update: if false;
          allow delete: if isSignedIn() && isThreadParticipant();
        }
      }
    }

    // /reviews/{reviewId}
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.reviewerId == request.auth.uid;
      allow update: if false;
      // Autor kasuje swoje recenzje tylko przy usuwaniu konta (NEIAccountDeletionService)
      allow delete: if isSignedIn() && resource.data.reviewerId == request.auth.uid;
    }

    // Własne wiadomości ze wszystkich rozmów naraz (collectionGroup) — usuwanie konta szuka
    // tak wiadomości w wątkach przy cudzych ogłoszeniach. Wymaga wyjątku indeksu na senderId.
    match /{path=**}/messages/{messageId} {
      allow read: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }

    // /reports/{reportId} — zgłoszenia treści (wytyczna App Store 1.2). Tylko zapis;
    // moderator czyta je w konsoli Firebase (docs/moderation.md).
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['reporterId', 'targetType', 'targetId', 'targetOwnerId',
          'excerpt', 'reason', 'status', 'createdAt']) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.targetType in ['offer', 'alert', 'user', 'message', 'review'] &&
        request.resource.data.reason in ['spam', 'inappropriate', 'harassment', 'dangerous', 'other'] &&
        request.resource.data.targetId is string &&
        request.resource.data.targetId.size() > 0 && request.resource.data.targetId.size() <= 300 &&
        request.resource.data.targetOwnerId is string &&
        request.resource.data.targetOwnerId != request.auth.uid &&
        request.resource.data.excerpt is string && request.resource.data.excerpt.size() <= 500 &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }
  }
}
